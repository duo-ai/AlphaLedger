# Experimental execution-policy rules for commands that request to run outside
# the sandbox. Hooks provide the separate contextual guard inside the project.

prefix_rule(
    pattern = ["rm", ["-rf", "-fr"]],
    decision = "forbidden",
    justification = "Recursive forced deletion is outside the AlphaLedger workflow.",
)

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "Do not destroy the user's working-tree changes.",
)

prefix_rule(
    pattern = ["git", "clean", ["-f", "-fd", "-df", "-fx", "-fdx", "-xdf"]],
    decision = "forbidden",
    justification = "Do not remove untracked work from the repository.",
)

prefix_rule(
    pattern = ["git", ["add", "commit", "push"]],
    decision = "prompt",
    justification = "Repository mutation requires an explicit user request.",
)

prefix_rule(
    pattern = ["uv", ["add", "lock"]],
    decision = "prompt",
    justification = "Dependency or lockfile changes require review.",
)

prefix_rule(
    pattern = ["uv", "run", "alphaledger", "paper-smoke"],
    decision = "prompt",
    justification = "The one-contract paper lifecycle is human-controlled.",
)
